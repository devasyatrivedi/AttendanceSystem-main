# ── Database ──────────────────────────────────────────────────────────────────
# MongoDB Atlas connection string (or local: mongodb://localhost:27017/attendance_db)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/attendance_db?retryWrites=true&w=majority

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=your_jwt_secret_here

# ── Email (Gmail App Password) ────────────────────────────────────────────────
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password

# ── Python (local face recognition — Phase 1 & 2) ────────────────────────────
PYTHON_PATH=python

# ── Face Recognition Microservice (Phase 3+) ─────────────────────────────────
# VISION_SERVICE_URL=https://your-face-service.onrender.com

# ── Cloudinary (Phase 5) ──────────────────────────────────────────────────────
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
